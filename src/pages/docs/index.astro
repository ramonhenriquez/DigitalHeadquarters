---
/**
 * Index of every Markdown file in Homelab-Portfolio, built from the
 * synced copy at build time. New documents appear here automatically
 * after the next build; this is the part of the site that is automatic.
 */
import Layout from '../../components/layout/Layout.astro';
import { getDocs, shortCommit, syncInfo } from '../../lib/sources';
import { projectBySlug } from '../../data/projects';
import { SITE } from '../../data/site';

const BASE = import.meta.env.BASE_URL;
const docs = await getDocs();
const info = syncInfo();
const commit = shortCommit();
const groups = (['Overview', 'Architecture', 'Projects'] as const)
  .map((g) => ({ name: g, docs: docs.filter((d) => d.group === g) }))
  .filter((g) => g.docs.length);
---

<Layout title="Documentation" description="Every technical document from the Homelab-Portfolio repository, rendered on this site with links back to the source on GitHub.">
  <header class="page-head">
    <div class="container">
      <h1>Documentation</h1>
      <p>
        The technical source of truth for this site: {docs.length} Markdown documents from{' '}
        <a href={SITE.sourceRepo}>Homelab-Portfolio</a>, rendered as written. Case studies summarise them; these are the originals.
      </p>
    </div>
  </header>

  <div class="container" style="padding-block: 8px 72px">
    <p class="small muted">
      Synced from <code>{info.ref}</code>
      {commit && <> at commit <a href={`${SITE.sourceRepo}/commit/${info.commit}`}><code>{commit}</code></a></>}
      {info.commitDate && <> ({info.commitDate})</>}. "Last changed" is the date of the last commit that touched each file.
    </p>

    {groups.map((g) => (
      <section class="doc-group" aria-labelledby={`g-${g.name}`}>
        <h2 id={`g-${g.name}`}>{g.name}</h2>
        <ul class="doc-list" role="list">
          {g.docs.map((d) => (
            <li>
              <div>
                <a class="doc-list__title" href={d.href}>{d.title}</a>
                <div class="doc-list__path"><code>{d.sourcePath}</code></div>
              </div>
              <div class="doc-list__meta">
                {d.project && projectBySlug[d.project] && <div><a href={`${BASE}projects/${d.project}/`}>Case study</a></div>}
                <div>Last changed {d.updated ?? 'unknown'}</div>
              </div>
            </li>
          ))}
        </ul>
      </section>
    ))}

    <section class="panel" style="margin-top:48px" aria-labelledby="workflow-h">
      <h2 id="workflow-h">How I document</h2>
      <p class="muted">
        Projects are written up in Homelab-Portfolio as they're built, with the configuration used, the tests run and
        what was learned. The lab also runs BookStack as an internal wiki (see the{' '}
        <a href={`${BASE}projects/bookstack/`}>BookStack lab page</a>); it isn't public, so nothing from it is published here. This site is rebuilt from the repository, so a new document shows up here without
        any change to the website's code.
      </p>
    </section>
  </div>
</Layout>
