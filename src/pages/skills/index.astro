---
import Layout from '../../components/layout/Layout.astro';
import EvidenceBadge from '../../components/ui/EvidenceBadge.astro';
import { DOMAINS, SKILLS, LISTED_WITHOUT_EVIDENCE, skillStrength } from '../../data/skills';
import { docHref } from '../../lib/sources';
import { EVIDENCE } from '../../data/status';

const BASE = import.meta.env.BASE_URL;
const projectCount = (s: (typeof SKILLS)[number]) => new Set(s.evidence.map((e) => e.project).filter(Boolean)).size;
---

<Layout title="Skills" description="Technical skills backed by documented homelab evidence: what was done, how strong the evidence is, and which document shows it.">
  <header class="page-head">
    <div class="container">
      <h1>Skills, with the evidence</h1>
      <p>
        Each skill is rated by its strongest evidence in Homelab-Portfolio, from a recorded test down to a passing
        mention, and every piece of evidence links to the project and document that shows it.
        Work-history skills are on the <a href={`${BASE}resume/`}>resume</a>.
      </p>
    </div>
  </header>

  <div class="container" style="padding-block: 24px 72px">
    <details class="panel" style="margin-bottom:12px">
      <summary><strong>How evidence is rated</strong></summary>
      <dl class="legend">
        {Object.entries(EVIDENCE).map(([k, e]) => (
          <div><dt><EvidenceBadge level={k as keyof typeof EVIDENCE} /></dt><dd>{e.description}</dd></div>
        ))}
      </dl>
    </details>

    {DOMAINS.map((d) => {
      const skills = SKILLS.filter((s) => s.domain === d.name);
      if (!skills.length) return null;
      return (
        <section class="domain" data-layer={d.layer} aria-labelledby={`dom-${d.layer}`}>
          <h2 class="domain__title" id={`dom-${d.layer}`}>{d.name}</h2>
          <ul class="skill-grid" role="list">
            {skills.map((s) => (
              <li data-layer={s.layer}>
                <a class="skill-card" href={`${BASE}skills/${s.slug}/`}>
                  <h3>{s.name}</h3>
                  <p>{s.summary}</p>
                  <span class="skill-card__foot">
                    <EvidenceBadge level={skillStrength(s)} />
                    <span>{s.evidence.length} evidence item{s.evidence.length === 1 ? '' : 's'}{projectCount(s) > 0 && `, ${projectCount(s)} project${projectCount(s) === 1 ? '' : 's'}`}</span>
                  </span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      );
    })}

    <section class="unevidenced" aria-labelledby="unev-h">
      <h2 id="unev-h">Listed, with evidence not yet documented</h2>
      <p class="muted" style="max-width:64ch">
        The <a href={docHref(LISTED_WITHOUT_EVIDENCE[0].source)}>Homelab-Portfolio README</a> lists these skills, but no document
        in the repository shows them being used yet. They don't get evidence pages until one does.
      </p>
      <ul class="unevidenced__list" role="list">
        {LISTED_WITHOUT_EVIDENCE.map((u) => (
          <li>
            <strong>{u.name}</strong>
            <span class="not-documented__label">Evidence not yet documented</span>
            <p>{u.note}</p>
          </li>
        ))}
      </ul>
    </section>
  </div>
</Layout>
