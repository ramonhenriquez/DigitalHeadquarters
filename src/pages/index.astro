  {
    category: 'Virtualization',
    skills: ['Proxmox VE', 'Virtual Machines', 'LXC Containers'],
  },
  {
    category: 'Operating Systems',
    skills: ['Windows Server', 'Linux', 'Fedora', 'Kali Linux'],
  },
  {
    category: 'Identity & Access',
    skills: ['Active Directory', 'Group Policy', 'DNS'],
  },
  {
    category: 'Security',
    skills: ['Wazuh', 'Suricata', 'SIEM', 'Endpoint Monitoring', 'Security Monitoring'],
  },
