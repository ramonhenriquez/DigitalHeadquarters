---
/**
 * src/pages/index.astro — Digital Headquarters Homepage
 * ─────────────────────────────────────────────────────────────────
 * Data + orchestration only. All rendering is handled by components.
 *
 * CONTENT STANDARDS (from master project doc):
 *   - Only list technologies actually deployed
 *   - No fabricated metrics or statistics
 *   - Use "planned" / "learning" for roadmap items
 *   - Every claim must be something you can explain in an interview
 *
 * Section order:
 *   1. Hero             (Hero.astro — includes StatusPanel)
 *   2. Lab Overview     (4 honest pillar cards, replaces fake stats)
 *   3. Projects         (ProjectCard.astro × 6)
 *   4. Tech Stack       (TechStack.astro — master doc list only)
 *   5. Learning Journey (LearningJourney.astro)
 *   6. Contact CTA      (CTA.astro)
 */

import Layout          from '../components/Layout.astro';
import Hero            from '../components/Hero.astro';
import ProjectCard     from '../components/ProjectCard.astro';
import TechStack       from '../components/TechStack.astro';
import type { SkillGroup } from '../components/TechStack.astro';
import LearningJourney from '../components/LearningJourney.astro';
import type { Milestone }  from '../components/LearningJourney.astro';
import CTA             from '../components/CTA.astro';
import type { CTAAction }  from '../components/CTA.astro';

const BASE = import.meta.env.BASE_URL;


// ─── FEATURED PROJECTS ────────────────────────────────────────────
// Only list what is actually deployed and working.
// Descriptions use verified, conservative language.
// Tags: only technologies confirmed in use — nothing from the roadmap.

