// ─── CONTACT CTA ──────────────────────────────────────────────────
const ctaActions: CTAAction[] = [
  {
    label: 'GitHub',
    href: 'https://github.com/ramonhenriquez',   // ← update with your username
    variant: 'primary',
    external: true,
  },
  {
    label: 'Resume',
    href: `${BASE}resume/`,
    variant: 'outline',
  },
  {
    label: 'Email Me',
    href: 'mailto:ramonhenriquez301@gmail.com',
    variant: 'ghost',
