    statusLabel: 'Active',
    statusColor: 'green' as const,
    href: `${BASE}projects/wazuh/`,
  },
  {
    title: 'Active Directory Lab',
    category: 'IDENTITY',
    description:
      'Windows Server domain built to practice enterprise identity management. Configured Active Directory, Group Policy security baselines, and DNS. Used to manage lab machines and practice real-world IT administration skills.',
