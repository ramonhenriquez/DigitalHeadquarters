---

<Layout
  title="Ramon Henriquez — Systems Technician & Homelab Engineer"
  description="Systems Technician II building enterprise-inspired infrastructure and security monitoring through a practical homelab. Aspiring SOC Analyst."
>

  <!-- ① HERO -->
  <Hero />


  <!-- ② LAB OVERVIEW -->
  <section id="infrastructure" class="section infra-stats" aria-labelledby="lab-overview-heading">
    <div class="container">

      <div class="section-header">
        <span class="section-eyebrow">LAB OVERVIEW</span>
        <h2 class="section-title" id="lab-overview-heading">Infrastructure at a Glance</h2>
        <p class="section-desc">
          Virtual machines, containers, and self-hosted services running across a
          Proxmox-based homelab environment.
        </p>
      </div>

      <div class="pillar-grid">

        <div class="pillar-card">
          <p class="pillar-card__eyebrow">VIRTUALIZATION</p>
          <h3 class="pillar-card__title">Proxmox-Based Lab</h3>
          <p class="pillar-card__desc">
            Virtual machines and LXC containers running across Proxmox VE for
            identity management, security monitoring, documentation, and media
            services.
          </p>
        </div>

        <div class="pillar-card">
          <p class="pillar-card__eyebrow">SECURITY MONITORING</p>
          <h3 class="pillar-card__title">Wazuh + Suricata</h3>
          <p class="pillar-card__desc">
            Wazuh deployed with agents on Linux, Fedora, and Windows endpoints.
            Suricata forwards network alerts into Wazuh through eve.json
            ingestion for unified visibility.
          </p>
        </div>

        <div class="pillar-card">
          <p class="pillar-card__eyebrow">ENDPOINT VISIBILITY</p>
          <h3 class="pillar-card__title">Linux, Fedora &amp; Windows</h3>
          <p class="pillar-card__desc">
            Security monitoring and administration practiced across multiple
            operating systems — Linux servers, Fedora workstation, and Windows
            endpoints — within the homelab.
          </p>
        </div>

        <div class="pillar-card">
          <p class="pillar-card__eyebrow">DOCUMENTATION</p>
          <h3 class="pillar-card__title">BookStack + GitHub</h3>
          <p class="pillar-card__desc">
            Runbooks, network notes, and lessons learned documented in
            BookStack. Code and configuration tracked on GitHub. Documentation
            is treated as part of the work, not an afterthought.
          </p>
        </div>

      </div>
    </div>
  </section>


  <!-- ③ FEATURED PROJECTS -->
  <section id="projects" class="section" aria-labelledby="projects-heading">
    <div class="container">

      <div class="section-header">
        <span class="section-eyebrow">INFRASTRUCTURE PORTFOLIO</span>
        <h2 class="section-title" id="projects-heading">Featured Projects</h2>
        <p class="section-desc">
          Systems built, configured, and documented in my homelab —
          each one focused on developing real IT and security operations skills.
        </p>
      </div>

      <div class="projects-grid">
        {projects.map(project => (
          <ProjectCard {...project} />
        ))}
      </div>

    </div>
  </section>


  <!-- ④ TECHNOLOGY STACK -->
  <TechStack groups={skillGroups} />


  <!-- ⑤ LEARNING JOURNEY -->
  <LearningJourney milestones={milestones} />


  <!-- ⑥ CONTACT CTA -->
  <CTA
    sectionId="contact"
    title="Let's work together"
    description="Open to SOC Analyst, cybersecurity, and security operations roles where I can apply hands-on infrastructure, monitoring, troubleshooting, and documentation experience."
    actions={ctaActions}
  />

</Layout>
