    title: 'Jellyfin Media Server',
    category: 'MEDIA',
    description:
      'Self-hosted media service used to practice Linux container deployment, storage mounting, and service administration. Running in an LXC container and connected to network-attached storage.',
    tags: ['Jellyfin', 'LXC', 'Linux', 'Self-Hosted'],
    statusLabel: 'Active',
    statusColor: 'blue' as const,
    href: `${BASE}projects/jellyfin/`,
  },
  {
