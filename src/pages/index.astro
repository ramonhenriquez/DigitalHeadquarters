---
/**
 * Home — "Explore the infrastructure I've built."
 * The explorer is the one bold element; everything else supports it.
 * Counts on this page are computed from the data files and the synced
 * Homelab-Portfolio docs; none are typed in by hand.
 */
import Layout from '../components/layout/Layout.astro';
import TopologyExplorer from '../components/topology/TopologyExplorer.astro';
import ProjectRow from '../components/projects/ProjectRow.astro';
import AlertRecord from '../components/projects/AlertRecord.astro';
import Timeline from '../components/timeline/Timeline.astro';
import CTA from '../components/ui/CTA.astro';
import { SITE, PUBLIC_CONTACT } from '../data/site';
import { FEATURED, LAB } from '../data/projects';
import { NODES } from '../data/infrastructure';
import { LAYERS } from '../data/status';
import { MILESTONES } from '../data/timeline';
import { getDocs, shortCommit, syncInfo } from '../lib/sources';

const BASE = import.meta.env.BASE_URL;
const docs = await getDocs();
const info = syncInfo();
const commit = shortCommit();

const homelabMilestones = MILESTONES.filter((m) => m.track === 'homelab' || m.track === 'documentation');
---

<Layout title={SITE.name}>
  <section class="hero" aria-labelledby="hero-h">
    <div class="container container--wide">
      <div class="hero__grid">
        <div>
          <p class="hero__kicker">{SITE.name}, {SITE.title}</p>
          <h1 id="hero-h">Explore the infrastructure I've built.</h1>
        </div>
        <div>
          <p class="hero__lead">
            Two Proxmox hosts, an Active Directory domain, and a Wazuh SIEM fed by Suricata and remote agents.
            Select any system to see what its documentation says about it, and where that documentation stops.
          </p>
          <div class="hero__actions">
            <a class="btn btn--primary" href={`${BASE}projects/`}>See the projects</a>
            <a class="btn btn--outline" href={`${BASE}resume/`}>Resume</a>
          </div>
        </div>
      </div>
      <p class="hero__facts">
        <span><strong>{FEATURED.length}</strong>case studies</span>
        <span><strong>{LAB.length}</strong>lab systems</span>
        <span><strong>{NODES.length}</strong>mapped components</span>
        <span><strong>{LAYERS.length}</strong>architecture views</span>
        <span><strong>{docs.length}</strong>source documents</span>
        {commit && (
          <span>Docs synced from Homelab-Portfolio <a href={`${SITE.sourceRepo}/commit/${info.commit}`}><code>{commit}</code></a></span>
        )}
      </p>
    </div>
  </section>

  <div class="hero__explorer">
    <div class="container container--wide">
      <TopologyExplorer id="home" initialView="security" headingLevel="h2" label="Homelab infrastructure explorer" />
      <p class="small muted" style="margin-top:10px">
        Tip: open the full-page <a href={`${BASE}infrastructure/`}>infrastructure explorer</a> for shareable links to any view or component,
        or press <kbd>/</kbd> to search.
      </p>
    </div>
  </div>

  <section class="band" aria-labelledby="work-h">
    <div class="container">
      <div class="band__head band__head--split">
        <div>
          <h2 id="work-h">Featured case studies</h2>
          <p>The two projects with enough documented implementation and evidence for a structured case study. Coverage indicators show where the documentation is complete, partial, or still missing.</p>
        </div>
        <a class="link-arrow" href={`${BASE}projects/`}>All projects</a>
      </div>
      <ul class="register" role="list">
        {FEATURED.map((p) => <ProjectRow project={p} />)}
      </ul>

      <h3 class="register-subhead">Lab systems</h3>
      <p class="muted register-sublead">Running and documented, with technical write-ups still being expanded.</p>
      <ul class="register register--compact" role="list">
        {LAB.map((p) => <ProjectRow project={p} headingLevel="h4" />)}
      </ul>
    </div>
  </section>

  <section class="band band--inset" aria-labelledby="evidence-h">
    <div class="container">
      <div class="band__head">
        <h2 id="evidence-h">Tested, not just installed</h2>
        <p>A detection only counts once it has fired. Here is one documented test from start to disposition, exactly as recorded in Homelab-Portfolio.</p>
      </div>
      <AlertRecord headingLevel="h3" />
    </div>
  </section>

  <section class="band" aria-labelledby="timeline-h">
    <div class="container">
      <div class="band__head band__head--split">
        <div>
          <h2 id="timeline-h">How the lab grew</h2>
          <p>Homelab and documentation milestones. Each entry says where its date comes from.</p>
        </div>
        <a class="link-arrow" href={`${BASE}timeline/`}>Full timeline, including career</a>
      </div>
      <Timeline items={homelabMilestones} filters={false} headingLevel="h3" />
    </div>
  </section>

  <CTA
    title="Let's talk"
    description="I'm a Systems Technician II working toward security operations. If you're hiring for SOC or infrastructure roles, I'd like to hear from you."
    actions={[
      { label: 'Email me', href: `mailto:${PUBLIC_CONTACT.email}`, variant: 'primary' },
      { label: 'LinkedIn', href: PUBLIC_CONTACT.linkedin, variant: 'outline', external: true },
      { label: 'GitHub', href: PUBLIC_CONTACT.github, variant: 'ghost', external: true },
    ]}
  />
</Layout>
