---
/** The old /documentation/ page moved to /docs/. Kept as a redirect so existing links still work. */
const target = `${import.meta.env.BASE_URL}docs/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>Moved to Documentation</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={target} />
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <p>This page moved to <a href={target}>Documentation</a>.</p>
  </body>
</html>
