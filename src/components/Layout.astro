---
/**
 * Layout.astro
 * ─────────────────────────────────────────────────────────────────
 * The HTML shell that wraps every page on the site.
 *
 * Theme flash prevention:
 *   The first <script is:inline> in <head> reads localStorage and
 *   sets data-theme="light" on <html> synchronously — before any
 *   CSS or content renders — so there is no flash when a returning
 *   user has a stored light-mode preference.
 *
 *   Dark mode is the default (no attribute). The script only acts
 *   when the user previously chose light. No flash in dark mode.
 */

import Navbar from './Navbar.astro';
import Footer from './Footer.astro';
import '../styles/portfolio.css';

interface Props {
  /** Page <title> — keep under 60 characters */
  title: string;
  /** Meta description — keep under 160 characters */
  description?: string;
  /** Open Graph title override (defaults to title) */
  ogTitle?: string;
  /** Open Graph description override (defaults to description) */
  ogDescription?: string;
}

const {
  title,
  description = 'Ramon Henriquez — Systems Technician II and Homelab Engineer building enterprise-grade infrastructure and security operations.',
  ogTitle,
  ogDescription,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <!--
      THEME FLASH PREVENTION — must be the first script, before CSS.
      Reads localStorage synchronously. Sets data-theme="light" if the
      user previously chose light mode. Wrapped in try/catch for
      environments where localStorage is unavailable (e.g. private browsing).
    -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          if (stored === 'light') {
            document.documentElement.setAttribute('data-theme', 'light');
          }
        } catch (e) {}
      })();
    </script>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type"        content="website" />
    <meta property="og:title"       content={ogTitle ?? title} />
    <meta property="og:description" content={ogDescription ?? description} />
    <meta property="og:site_name"   content="Ramon Henriquez" />

    <!-- Both themes are supported -->
    <meta name="theme-color" content="#0d1117" />
    <meta name="color-scheme" content="dark light" />

    <title>{title}</title>

    <!-- Fonts — Inter (headings + body) + JetBrains Mono (utility/code) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <Navbar />

    <main id="main-content">
      <slot />
    </main>

    <Footer />
  </body>
</html>
