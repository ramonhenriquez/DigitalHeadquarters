---
/**
 * Hero.astro
 * ─────────────────────────────────────────────────────────────────
 * Homepage hero section.
 *
 * StatusPanel meta strings use honest, verifiable descriptions —
 * no fabricated event rates, document counts, or VM numbers.
 * When real metrics are available (e.g. from an Uptime Kuma API),
 * replace the static array with a fetch() in the frontmatter.
 */

import StatusPanel from './StatusPanel.astro';
import type { StatusRow } from './StatusPanel.astro';

const BASE = import.meta.env.BASE_URL;

const statusRows: StatusRow[] = [
  { name: 'proxmox.homelab',  fill: '95%',  meta: 'Hypervisor platform',       badge: 'RUNNING',   color: 'green' },
  { name: 'wazuh.siem',       fill: '90%',  meta: '3 monitored endpoints',      badge: 'ACTIVE',    color: 'green' },
  { name: 'active.directory', fill: '100%', meta: 'Windows domain',             badge: 'HEALTHY',   color: 'green' },
  { name: 'bookstack.docs',   fill: '100%', meta: 'Knowledge base',             badge: 'ONLINE',    color: 'blue'  },
  { name: 'jellyfin.media',   fill: '100%', meta: 'Media server',               badge: 'ONLINE',    color: 'blue'  },
];
---

<section class="hero" aria-label="Introduction">
  <div class="hero__glow" aria-hidden="true"></div>

  <div class="hero__content container">

    <div class="hero__eyebrow">
      <span class="badge badge--available">AVAILABLE FOR OPPORTUNITIES</span>
    </div>

    <h1 class="hero__name">Ramon Henriquez</h1>

    <p class="hero__roles" aria-label="Current titles">
      <span>Systems Technician II</span>
      <span class="role-sep" aria-hidden="true">·</span>
      <span>Homelab Engineer</span>
      <span class="role-sep" aria-hidden="true">·</span>
      <span class="role-highlight">Aspiring SOC Analyst</span>
    </p>

    <p class="hero__tagline">
      I build and document enterprise-inspired infrastructure, security
      monitoring, and self-hosted services through a practical homelab
      environment.
    </p>

    <StatusPanel rows={statusRows} />

    <div class="hero__actions">
      <a href={`${BASE}#projects`} class="btn btn--primary">View Projects</a>
      <a
        href="https://github.com/ramonhenriquez"
        class="btn btn--outline"
        target="_blank"
        rel="noopener noreferrer"
      >GitHub Profile</a>
      <a href={`${BASE}resume/`} class="btn btn--ghost">View Resume</a>
    </div>

  </div>
</section>
