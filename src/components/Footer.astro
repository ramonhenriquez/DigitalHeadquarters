---
/**
 * Footer.astro
 * ─────────────────────────────────────────────────────────────────
 * Site footer — rendered by Layout.astro on every page.
 * All styles live in portfolio.css (no inline <style> blocks here).
 *
 * Links use import.meta.env.BASE_URL so paths resolve correctly
 * on both localhost and GitHub Pages subdirectory deployments.
 *
 * Link destinations:
 *   Projects      → homepage #projects anchor (page not yet built)
 *   Documentation → real page at /documentation/
 *   Contact       → homepage #contact anchor (page not yet built)
 *   GitHub        → public profile (external, new tab)
 */

const BASE = import.meta.env.BASE_URL;
const year = new Date().getFullYear();

const quickLinks = [
  { label: 'Projects',      href: `${BASE}#projects`,                        external: false },
  { label: 'Documentation', href: `${BASE}documentation/`,                   external: false },
  { label: 'Contact',       href: `${BASE}#contact`,                         external: false },
  { label: 'GitHub',        href: 'https://github.com/ramonhenriquez',       external: true  },
];
---

<footer class="footer">
  <div class="footer__inner container">

    <div class="footer__left">
      <span class="footer__id">
        Ramon Henriquez &middot; Systems Engineer
      </span>
      <span class="footer__copy">
        &copy; {year} &middot; Built with Astro &middot; Deployed on GitHub Pages
      </span>
    </div>

    <nav class="footer__links" aria-label="Footer navigation">
      {quickLinks.map(link => (
        <a
          href={link.href}
          class="footer__link"
          target={link.external ? '_blank' : undefined}
          rel={link.external ? 'noopener noreferrer' : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

  </div>
</footer>
