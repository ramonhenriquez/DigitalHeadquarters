---
/**
 * CTA.astro
 * ─────────────────────────────────────────────────────────────────
 * Reusable call-to-action section block.
 *
 * Props:
 *   title       — CTA heading
 *   description — supporting paragraph
 *   actions     — array of button config objects
 *   headingId   — id for the h2 (avoids duplicate ids when used twice)
 *   sectionId   — id on the <section> element, used for anchor links
 *                 e.g. sectionId="contact" lets #contact nav link work
 */

export interface CTAAction {
  label: string;
  href: string;
  variant: 'primary' | 'outline' | 'ghost';
  /** Opens in a new tab with rel="noopener noreferrer" */
  external?: boolean;
}

interface Props {
  title: string;
  description: string;
  actions: CTAAction[];
  headingId?: string;
  sectionId?: string;
}

const {
  title,
  description,
  actions,
  headingId = 'cta-heading',
  sectionId,
} = Astro.props;
---

<section class="cta-section" id={sectionId} aria-labelledby={headingId}>
  <div class="container">
    <div class="cta-card">

      <div class="cta-card__text">
        <h2 class="cta-card__title" id={headingId}>{title}</h2>
        <p class="cta-card__desc">{description}</p>
      </div>

      <div class="cta-card__actions">
        {actions.map(action => (
          <a
            href={action.href}
            class={`btn btn--${action.variant}`}
            target={action.external ? '_blank' : undefined}
            rel={action.external ? 'noopener noreferrer' : undefined}
          >
            {action.label}
          </a>
        ))}
      </div>

    </div>
  </div>
</section>
