---
/**
 * ThemeToggle.astro
 * ─────────────────────────────────────────────────────────────────
 * Light / dark mode toggle button for the Navbar.
 *
 * Theme logic:
 *   Default (no data-theme attribute) = dark mode
 *   data-theme="light"                = light mode
 *   Preference stored in localStorage key "theme"
 *
 * Flash prevention is handled separately in Layout.astro <head>.
 * This component only wires up the click handler.
 *
 * Sun icon  — visible in dark mode  (click → switch to light)
 * Moon icon — visible in light mode (click → switch to dark)
 *
 * CSS visibility of icons is controlled by:
 *   html[data-theme="light"] .icon-sun  { display: none }
 *   html[data-theme="light"] .icon-moon { display: block }
 * See portfolio.css section 23.
 */
---

<button
  id="theme-toggle"
  class="theme-toggle"
  aria-label="Switch to light mode"
  title="Toggle light / dark mode"
>
  <!-- Sun — shown in dark mode -->
  <svg
    class="icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>
  </svg>

  <!-- Moon — shown in light mode -->
  <svg
    class="icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
  </svg>
</button>

<script is:inline>
  (function () {
    var btn = document.getElementById('theme-toggle');
    if (!btn) return;

    /** Set aria-label to match the action the button will perform */
    function updateLabel(currentTheme) {
      btn.setAttribute(
        'aria-label',
        currentTheme === 'light' ? 'Switch to dark mode' : 'Switch to light mode'
      );
    }

    /** Apply a theme and persist it */
    function applyTheme(theme) {
      if (theme === 'light') {
        document.documentElement.setAttribute('data-theme', 'light');
      } else {
        document.documentElement.removeAttribute('data-theme');
      }
      try { localStorage.setItem('theme', theme); } catch (e) {}
      updateLabel(theme);
    }

    // Sync label with whatever theme the flash-prevention script already set
    var initial = document.documentElement.getAttribute('data-theme') || 'dark';
    updateLabel(initial);

    btn.addEventListener('click', function () {
      var current = document.documentElement.getAttribute('data-theme') || 'dark';
      applyTheme(current === 'light' ? 'dark' : 'light');
    });
  })();
</script>
