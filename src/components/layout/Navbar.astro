---
/**
 * Navbar.astro — sticky top navigation.
 * All hrefs go through BASE_URL so they work on GitHub Pages' subpath.
 * Below 900px the links collapse behind a Menu button (disclosure pattern).
 */
import ThemeToggle from './ThemeToggle.astro';
import { NAV, SITE } from '../../data/site';

const BASE = import.meta.env.BASE_URL;
const path = Astro.url.pathname;
const isActive = (p: string) => path.startsWith(`${BASE}${p}`);
---

<header class="nav">
  <div class="nav__inner container">
    <a class="nav__brand" href={BASE}>
      <span class="nav__mark" aria-hidden="true">RH</span>
      <span class="nav__name">{SITE.name}</span>
    </a>

    <nav class="nav__primary" id="nav-menu" aria-label="Main">
      <ul role="list">
        {NAV.map((item) => (
          <li>
            <a href={`${BASE}${item.path}`} aria-current={isActive(item.path) ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li class="nav__menu-only">
          <a href={`${BASE}resume/`} aria-current={isActive('resume') ? 'page' : undefined}>Resume</a>
        </li>
      </ul>
    </nav>

    <div class="nav__tools">
      <button type="button" class="palette-trigger" data-palette-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="11" cy="11" r="7" fill="none" stroke="currentColor" stroke-width="2"/><path d="m20 20-3.5-3.5" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
        <span class="palette-trigger__label">Search</span>
        <span class="palette-trigger__keys" aria-hidden="true"><kbd data-mod-key>Ctrl</kbd><kbd>K</kbd></span>
      </button>
      <ThemeToggle />
      <a class="btn btn--small nav__resume" href={`${BASE}resume/`} aria-current={isActive('resume') ? 'page' : undefined}>Resume</a>
      <button type="button" class="nav__menu" aria-expanded="false" aria-controls="nav-menu" data-nav-toggle>
        Menu
      </button>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
  const menu = document.getElementById('nav-menu');
  if (toggle && menu) {
    const set = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      menu.toggleAttribute('data-open', open);
    };
    toggle.addEventListener('click', () => set(toggle.getAttribute('aria-expanded') !== 'true'));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        set(false);
        toggle.focus();
      }
    });
  }
  // Show ⌘ instead of Ctrl on Apple platforms
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    document.querySelectorAll('[data-mod-key]').forEach((el) => (el.textContent = '⌘'));
  }
</script>
