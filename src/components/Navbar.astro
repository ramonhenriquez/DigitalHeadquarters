---
/**
 * Navbar.astro
 * ─────────────────────────────────────────────────────────────────
 * Sticky top navigation bar.
 *
 * - Left:  RH monogram + "homelab.engineer" + live status dot
 * - Right: Nav links (hidden on mobile) + Resume CTA button
 *
 * To add a nav link, edit the `navLinks` array below.
 * Links map to pages in src/pages/ — add the page file to activate.
 */

const navLinks = [
  { label: 'Infrastructure', href: '/infrastructure' },
  { label: 'Projects',       href: '/projects'       },
  { label: 'Documentation',  href: '/documentation'  },
  { label: 'Contact',        href: '/contact'        },
];

// Detect active page for aria-current
const { pathname } = Astro.url;
---

<nav class="nav" aria-label="Main navigation">
  <div class="nav__inner container">

    <!-- Brand -->
    <a class="nav__brand" href="/" aria-label="Ramon Henriquez — home">
      <span class="nav__brand-monogram">RH</span>
      <span class="nav__brand-sep">/</span>
      <span class="text-muted">homelab.engineer</span>
      <span
        class="nav__status-dot"
        title="All systems operational"
        aria-hidden="true"
      ></span>
    </a>

    <!-- Links -->
    <ul class="nav__links" role="list">
      {navLinks.map(link => (
        <li class="nav__hide-mobile">
          <a
            href={link.href}
            aria-current={pathname === link.href ? 'page' : undefined}
          >
            {link.label}
          </a>
        </li>
      ))}

      <!-- Resume CTA — always visible -->
      <li>
        <a
          href="/resume"
          class="btn btn--sm btn--outline"
          aria-label="View resume"
        >
          Resume
        </a>
      </li>
    </ul>

  </div>
</nav>
